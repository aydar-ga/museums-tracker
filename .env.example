# Local Next.js/Vercel-compatible environment.
APP_PORT=5001

# Neon Postgres (auto-provisioned by Vercel Marketplace Neon integration).
# Vercel typically injects POSTGRES_URL; this app also accepts DATABASE_URL.
# DATABASE_URL=
# POSTGRES_URL=

# Used to sign one-time magic-link tokens. Required for shared deployments.
# On Vercel: Project Settings → Environment Variables → add AUTH_SECRET for Production + Preview.
AUTH_SECRET=change-this-before-any-shared-environment

# Optional public URL used inside generated magic links on Vercel.
# PUBLIC_APP_URL=https://your-preview-or-production-url.vercel.app

# Local/CI only: return magic links in the API response and show them on screen.
# Never set this on a shared deployment; it lets anyone sign in as any email.
# AUTH_DEV_MAGIC_LINK=1

# Real email delivery. Without these (and without AUTH_DEV_MAGIC_LINK=1),
# magic-link sign-in answers 503.
# RESEND_API_KEY=re_xxx
# AUTH_EMAIL_FROM="Museums EU Atlas <noreply@example.com>"
